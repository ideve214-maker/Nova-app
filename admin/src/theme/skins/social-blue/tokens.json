{
  "name": "社交蓝",
  "version": "1.0.0",
  "product": "NOVA 用户端",
  "description": "Connect with the people who matter. 保留星澜的令牌结构与交互规范，提供深浅两种模式。",
  "font": {
    "stack": [
      "-apple-system",
      "BlinkMacSystemFont",
      "Segoe UI",
      "PingFang SC",
      "Microsoft YaHei",
      "Noto Sans SC",
      "sans-serif"
    ],
    "recommendedWebfont": {
      "name": "Noto Sans SC",
      "source": "https://fonts.google.com/noto/specimen/Noto+Sans+SC",
      "license": "SIL Open Font License 1.1"
    },
    "size": {
      "body": 16,
      "title": 22,
      "subtitle": 18,
      "button": 16,
      "buttonSm": 14,
      "caption": 13,
      "badge": 11,
      "lineHeight": 1.45
    },
    "weight": {
      "brand": 800,
      "title": 800,
      "button": 700,
      "nav": 600,
      "body": 400
    },
    "tracking": {
      "brand": "0.06em",
      "button": "0.02em"
    }
  },
  "modes": {
    "dark": {
      "cv": "#101820",
      "bg": "#17212B",
      "sf": "#1F2C38",
      "s2": "#293846",
      "s3": "#354655",
      "tx": "#F5F7FA",
      "t2": "#B1BBC5",
      "t3": "#84919D",
      "ln": "#344554",
      "ln2": "rgba(255,255,255,0.07)",
      "ac": "#4B8BF5",
      "acHover": "#75A6FF",
      "acPressed": "#286FE0",
      "acSoft": "rgba(75,139,245,0.18)",
      "acGrad": "linear-gradient(180deg,#75A6FF 0%,#1877F2 100%)",
      "onac": "#FFFFFF",
      "dg": "#F06B69",
      "dgHover": "#FF8582",
      "dgPressed": "#D95150",
      "dgSoft": "rgba(240,107,105,0.16)",
      "dgGrad": "linear-gradient(180deg,#FF8582 0%,#D95150 100%)",
      "ok": "#42C99A",
      "warn": "#E7A943",
      "vip": "#E0C17B",
      "vipGrad": "linear-gradient(135deg,#F4DFA8 0%,#C79B48 100%)",
      "onvip": "#211A0B",
      "shadow": {
        "sm": "0 1px 2px rgba(0,0,0,.22)",
        "md": "0 8px 28px rgba(0,0,0,.28)",
        "sheet": "0 -8px 32px rgba(0,0,0,.32)",
        "btn": "0 4px 16px rgba(75,139,245,0.18)",
        "btnDanger": "0 4px 14px rgba(240,107,105,0.16)"
      }
    },
    "light": {
      "cv": "#E7EBF0",
      "bg": "#F0F2F5",
      "sf": "#FFFFFF",
      "s2": "#F0F2F5",
      "s3": "#E4E6EB",
      "tx": "#1C1E21",
      "t2": "#65676B",
      "t3": "#8A8D91",
      "ln": "#DADDE1",
      "ln2": "rgba(28,30,33,0.07)",
      "ac": "#1877F2",
      "acHover": "#3888F7",
      "acPressed": "#0866D9",
      "acSoft": "rgba(24,119,242,0.12)",
      "acGrad": "linear-gradient(180deg,#3888F7 0%,#1877F2 100%)",
      "onac": "#FFFFFF",
      "dg": "#D93025",
      "dgHover": "#E44B42",
      "dgPressed": "#B9231B",
      "dgSoft": "rgba(217,48,37,0.12)",
      "dgGrad": "linear-gradient(180deg,#E44B42 0%,#D93025 100%)",
      "ok": "#168A55",
      "warn": "#A86B12",
      "vip": "#8B6E32",
      "vipGrad": "linear-gradient(135deg,#E8D190 0%,#C4A056 100%)",
      "onvip": "#1A1408",
      "shadow": {
        "sm": "0 1px 2px rgba(0,0,0,.22)",
        "md": "0 8px 28px rgba(0,0,0,.28)",
        "sheet": "0 -8px 32px rgba(0,0,0,.32)",
        "btn": "0 4px 16px rgba(75,139,245,0.18)",
        "btnDanger": "0 4px 14px rgba(240,107,105,0.16)"
      }
    }
  },
  "cssVarMap": {
    "cv": "--cv",
    "bg": "--bg",
    "sf": "--sf",
    "s2": "--s2",
    "s3": "--s3",
    "tx": "--tx",
    "t2": "--t2",
    "t3": "--t3",
    "ln": "--ln",
    "ln2": "--ln2",
    "ac": "--ac",
    "acHover": "--ac-hover",
    "acPressed": "--ac-pressed",
    "acSoft": "--ac-soft",
    "acGrad": "--ac-grad",
    "onac": "--onac",
    "dg": "--dg",
    "dgHover": "--dg-hover",
    "dgPressed": "--dg-pressed",
    "dgSoft": "--dg-soft",
    "dgGrad": "--dg-grad",
    "ok": "--ok",
    "warn": "--warn",
    "vip": "--vip",
    "vipGrad": "--vip-grad",
    "onvip": "--onvip"
  },
  "radius": {
    "xs": "8px",
    "sm": "12px",
    "md": "16px",
    "lg": "20px",
    "xl": "24px",
    "pill": "999px",
    "button": "14px",
    "iconButton": "12px",
    "input": "14px",
    "card": "16px",
    "bubble": "18px",
    "bubbleTail": "6px",
    "sheetTop": "20px",
    "avatar": "50%"
  },
  "motion": {
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "duration": "0.18s",
    "pressScalePrimary": 0.97,
    "pressScaleIcon": 0.9
  },
  "buttons": {
    "primary": {
      "class": ".pb",
      "default": {
        "fill": "var(--ac-grad)",
        "color": "var(--onac)",
        "shadow": "var(--sh-btn)",
        "radius": "14px",
        "height": 44,
        "weight": 700
      },
      "pressed": {
        "transform": "scale(0.97)"
      },
      "disabled": {
        "opacity": 0.4
      }
    },
    "secondary": {
      "class": ".pb.s",
      "default": {
        "fill": "var(--s2)",
        "color": "var(--tx)",
        "border": "1px solid var(--ln)"
      }
    },
    "ghost": {
      "class": ".lk, .pb.g",
      "default": {
        "fill": "transparent",
        "color": "var(--ac)"
      }
    },
    "danger": {
      "class": ".pb.d",
      "default": {
        "fill": "var(--dg-grad)",
        "color": "#FFFFFF"
      }
    },
    "icon": {
      "class": ".ib",
      "default": {
        "fill": "transparent",
        "color": "var(--t2)",
        "size": 44,
        "radius": "12px"
      }
    }
  },
  "swipeActions": {
    "pin": "#4B8BF5",
    "mute": "#E7A943",
    "hide": "#84919D",
    "delete": "#F06B69"
  },
  "id": "social-blue"
}
