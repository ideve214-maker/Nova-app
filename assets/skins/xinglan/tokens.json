{
  "name": "星澜 Xinglan",
  "version": "1.0.0",
  "product": "VEXO 用户端",
  "description": "深夜星河感的靛紫光主题。深色为默认，浅色与 VIP 香槟金为变体。",
  "font": {
    "stack": [
      "-apple-system",
      "BlinkMacSystemFont",
      "Segoe UI",
      "PingFang SC",
      "Hiragino Sans GB",
      "Microsoft YaHei",
      "Noto Sans CJK SC",
      "Noto Sans SC",
      "sans-serif"
    ],
    "recommendedWebfont": {
      "name": "Noto Sans SC",
      "source": "https://fonts.google.com/noto/specimen/Noto+Sans+SC",
      "license": "SIL Open Font License 1.1",
      "note": "预览截图使用系统已安装的 Noto Sans CJK SC（同属 OFL 1.1）。未把字体文件打进应用包；上线时如需打包，请从官方源下载并遵守 OFL。"
    },
    "size": {
      "body": 16,
      "title": 22,
      "subtitle": 18,
      "button": 16,
      "buttonSm": 14,
      "caption": 13,
      "badge": 11,
      "lineHeight": 1.45
    },
    "weight": {
      "brand": 800,
      "title": 800,
      "button": 700,
      "nav": 600,
      "body": 400
    },
    "tracking": {
      "brand": "0.06em",
      "button": "0.02em"
    }
  },
  "modes": {
    "dark": {
      "cv": "#06070D",
      "bg": "#0A0C14",
      "sf": "#131622",
      "s2": "#1B1F2E",
      "s3": "#252A3C",
      "tx": "#F4F6FC",
      "t2": "#9AA3B8",
      "t3": "#6B7388",
      "ln": "#2A3044",
      "ln2": "rgba(255,255,255,0.06)",
      "ac": "#6E8BFF",
      "acHover": "#8BA3FF",
      "acPressed": "#5A75EE",
      "acSoft": "rgba(110,139,255,0.16)",
      "acGrad": "linear-gradient(180deg, #8BA3FF 0%, #6E8BFF 48%, #5B74F2 100%)",
      "onac": "#FFFFFF",
      "dg": "#E5726A",
      "dgHover": "#F0857E",
      "dgPressed": "#D45A52",
      "dgSoft": "rgba(229,114,106,0.16)",
      "dgGrad": "linear-gradient(180deg, #F0857E 0%, #E5726A 55%, #D45A52 100%)",
      "ok": "#4ECDC4",
      "warn": "#E8A03A",
      "vip": "#D4B06A",
      "vipGrad": "linear-gradient(135deg, #F0D9A0 0%, #D4B06A 55%, #C49A50 100%)",
      "onvip": "#1A1408",
      "shadow": {
        "sm": "0 1px 2px rgba(0,0,0,0.28)",
        "md": "0 8px 28px rgba(0,0,0,0.40)",
        "sheet": "0 -8px 32px rgba(0,0,0,0.45)",
        "btn": "0 4px 14px rgba(110,139,255,0.38), inset 0 1px 0 rgba(255,255,255,0.18)",
        "btnDanger": "0 4px 14px rgba(229,114,106,0.32), inset 0 1px 0 rgba(255,255,255,0.14)"
      }
    },
    "light": {
      "cv": "#E6E8F2",
      "bg": "#F3F4F9",
      "sf": "#FFFFFF",
      "s2": "#EEEFF5",
      "s3": "#E3E5EF",
      "tx": "#13151C",
      "t2": "#5C6478",
      "t3": "#8B91A3",
      "ln": "#E0E3EC",
      "ln2": "rgba(19,21,28,0.06)",
      "ac": "#4F6EF7",
      "acHover": "#6B86FF",
      "acPressed": "#3D58E0",
      "acSoft": "rgba(79,110,247,0.12)",
      "acGrad": "linear-gradient(180deg, #6B86FF 0%, #4F6EF7 50%, #3D58E0 100%)",
      "onac": "#FFFFFF",
      "dg": "#C44840",
      "dgHover": "#D45A52",
      "dgPressed": "#A83A34",
      "dgSoft": "rgba(196,72,64,0.12)",
      "dgGrad": "linear-gradient(180deg, #D45A52 0%, #C44840 55%, #A83A34 100%)",
      "ok": "#1FA89F",
      "warn": "#C4841A",
      "vip": "#8B6E32",
      "vipGrad": "linear-gradient(135deg, #E8D190 0%, #C4A056 55%, #8B6E32 100%)",
      "onvip": "#1A1408",
      "shadow": {
        "sm": "0 1px 2px rgba(16,20,40,0.06)",
        "md": "0 8px 24px rgba(16,20,40,0.08)",
        "sheet": "0 -8px 32px rgba(16,20,40,0.10)",
        "btn": "0 4px 14px rgba(79,110,247,0.28), inset 0 1px 0 rgba(255,255,255,0.35)",
        "btnDanger": "0 4px 14px rgba(196,72,64,0.22)"
      }
    },
    "darkVipGold": {
      "extends": "dark",
      "ac": "#E2C07A",
      "acHover": "#F0D9A0",
      "acPressed": "#C4A056",
      "acSoft": "rgba(226,192,122,0.16)",
      "acGrad": "linear-gradient(180deg, #F0D9A0 0%, #E2C07A 48%, #C4A056 100%)",
      "onac": "#1A1408",
      "vip": "#E2C07A",
      "ln": "#3A3426",
      "shadow": {
        "btn": "0 4px 14px rgba(226,192,122,0.32), inset 0 1px 0 rgba(255,255,255,0.28)"
      }
    },
    "lightVipGold": {
      "extends": "light",
      "ac": "#8B6E32",
      "acHover": "#A68540",
      "acPressed": "#6E5424",
      "acSoft": "rgba(139,110,50,0.14)",
      "acGrad": "linear-gradient(180deg, #A68540 0%, #8B6E32 50%, #6E5424 100%)",
      "onac": "#FFFFFF",
      "vip": "#8B6E32",
      "ln": "#E4DFD3",
      "shadow": {
        "btn": "0 4px 14px rgba(139,110,50,0.22), inset 0 1px 0 rgba(255,255,255,0.35)"
      }
    }
  },
  "cssVarMap": {
    "cv": "--cv",
    "bg": "--bg",
    "sf": "--sf",
    "s2": "--s2",
    "s3": "--s3",
    "tx": "--tx",
    "t2": "--t2",
    "t3": "--t3",
    "ln": "--ln",
    "ln2": "--ln2",
    "ac": "--ac",
    "acHover": "--ac-hover",
    "acPressed": "--ac-pressed",
    "acSoft": "--ac-soft",
    "acGrad": "--ac-grad",
    "onac": "--onac",
    "dg": "--dg",
    "dgHover": "--dg-hover",
    "dgPressed": "--dg-pressed",
    "dgSoft": "--dg-soft",
    "dgGrad": "--dg-grad",
    "ok": "--ok",
    "warn": "--warn",
    "vip": "--vip",
    "vipGrad": "--vip-grad",
    "onvip": "--onvip"
  },
  "radius": {
    "xs": "8px",
    "sm": "12px",
    "md": "16px",
    "lg": "20px",
    "xl": "24px",
    "pill": "999px",
    "button": "14px",
    "iconButton": "12px",
    "input": "14px",
    "card": "16px",
    "bubble": "18px",
    "bubbleTail": "6px",
    "sheetTop": "20px",
    "avatar": "50%"
  },
  "motion": {
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "duration": "0.18s",
    "pressScalePrimary": 0.97,
    "pressScaleIcon": 0.9
  },
  "buttons": {
    "primary": {
      "class": ".pb",
      "default": {
        "fill": "var(--ac-grad)",
        "color": "var(--onac)",
        "shadow": "var(--sh-btn)",
        "radius": "14px",
        "height": 44,
        "weight": 700
      },
      "hover": {
        "filter": "brightness(1.06)"
      },
      "pressed": {
        "transform": "scale(0.97)",
        "shadow": "none",
        "filter": "brightness(0.96)"
      },
      "disabled": {
        "opacity": 0.4,
        "shadow": "none"
      }
    },
    "secondary": {
      "class": ".pb.s",
      "default": {
        "fill": "var(--s2)",
        "color": "var(--tx)",
        "border": "1px solid var(--ln)",
        "shadow": "none"
      },
      "hover": {
        "fill": "var(--s3)"
      },
      "pressed": {
        "transform": "scale(0.97)",
        "fill": "var(--s3)"
      },
      "disabled": {
        "opacity": 0.4
      }
    },
    "ghost": {
      "class": ".lk, .pb.g",
      "default": {
        "fill": "transparent",
        "color": "var(--ac)",
        "border": "1px solid color-mix(in srgb, var(--ac) 45%, transparent)"
      },
      "hover": {
        "fill": "var(--ac-soft)"
      },
      "pressed": {
        "fill": "var(--ac-soft)",
        "transform": "scale(0.97)"
      },
      "disabled": {
        "opacity": 0.4
      }
    },
    "danger": {
      "class": ".pb.d",
      "default": {
        "fill": "var(--dg-grad)",
        "color": "#FFFFFF",
        "shadow": "var(--sh-dg)"
      },
      "hover": {
        "filter": "brightness(1.06)"
      },
      "pressed": {
        "transform": "scale(0.97)",
        "shadow": "none"
      },
      "disabled": {
        "opacity": 0.4
      }
    },
    "icon": {
      "class": ".ib",
      "default": {
        "fill": "transparent",
        "color": "var(--t2)",
        "size": 44,
        "radius": "12px"
      },
      "hover": {
        "fill": "var(--ac-soft)",
        "color": "var(--ac)"
      },
      "pressed": {
        "transform": "scale(0.9)",
        "fill": "var(--s2)"
      },
      "disabled": {
        "opacity": 0.4
      }
    }
  },
  "swipeActions": {
    "pin": "#6E8BFF",
    "mute": "#E8A03A",
    "hide": "#6B7388",
    "delete": "#E5726A"
  }
}
