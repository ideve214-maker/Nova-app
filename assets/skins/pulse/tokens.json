{
  "name": "脉冲",
  "version": "1.0.0",
  "product": "NOVA 用户端",
  "description": "Create your moment. 保留星澜的令牌结构与交互规范，提供深浅两种模式。",
  "font": {
    "stack": [
      "-apple-system",
      "BlinkMacSystemFont",
      "Segoe UI",
      "PingFang SC",
      "Microsoft YaHei",
      "Noto Sans SC",
      "sans-serif"
    ],
    "recommendedWebfont": {
      "name": "Noto Sans SC",
      "source": "https://fonts.google.com/noto/specimen/Noto+Sans+SC",
      "license": "SIL Open Font License 1.1"
    },
    "size": {
      "body": 16,
      "title": 22,
      "subtitle": 18,
      "button": 16,
      "buttonSm": 14,
      "caption": 13,
      "badge": 11,
      "lineHeight": 1.45
    },
    "weight": {
      "brand": 800,
      "title": 800,
      "button": 700,
      "nav": 600,
      "body": 400
    },
    "tracking": {
      "brand": "0.06em",
      "button": "0.02em"
    }
  },
  "modes": {
    "dark": {
      "cv": "#050505",
      "bg": "#0B0B0D",
      "sf": "#151519",
      "s2": "#202026",
      "s3": "#2B2B33",
      "tx": "#F7F7F8",
      "t2": "#A7A7B0",
      "t3": "#707078",
      "ln": "#303038",
      "ln2": "rgba(255,255,255,0.07)",
      "ac": "#25F4EE",
      "acHover": "#72FFF9",
      "acPressed": "#12CFC9",
      "acSoft": "rgba(37,244,238,0.15)",
      "acGrad": "linear-gradient(135deg, #25F4EE 0%, #17D9D4 52%, #FE2C55 100%)",
      "onac": "#050505",
      "dg": "#FE2C55",
      "dgHover": "#FF5878",
      "dgPressed": "#E51F49",
      "dgSoft": "rgba(254,44,85,0.16)",
      "dgGrad": "linear-gradient(180deg, #FF5878 0%, #FE2C55 100%)",
      "ok": "#35D39A",
      "warn": "#F6B94A",
      "vip": "#D9B7FF",
      "vipGrad": "linear-gradient(135deg,#F0D9FF 0%,#B88BFF 100%)",
      "onvip": "#1B1026",
      "shadow": {
        "sm": "0 1px 2px rgba(0,0,0,.22)",
        "md": "0 8px 28px rgba(0,0,0,.28)",
        "sheet": "0 -8px 32px rgba(0,0,0,.32)",
        "btn": "0 4px 16px rgba(37,244,238,0.15)",
        "btnDanger": "0 4px 14px rgba(254,44,85,0.16)"
      }
    },
    "light": {
      "cv": "#E9F7F7",
      "bg": "#F7FBFB",
      "sf": "#FFFFFF",
      "s2": "#EEF5F5",
      "s3": "#E1EEEE",
      "tx": "#15171A",
      "t2": "#59636A",
      "t3": "#89949A",
      "ln": "#DCE7E7",
      "ln2": "rgba(21,23,26,0.07)",
      "ac": "#087F83",
      "acHover": "#07999C",
      "acPressed": "#06666A",
      "acSoft": "rgba(8,127,131,0.12)",
      "acGrad": "linear-gradient(135deg,#25CFCB 0%,#087F83 70%,#FE2C55 100%)",
      "onac": "#071516",
      "dg": "#D91F49",
      "dgHover": "#E83B60",
      "dgPressed": "#B9173B",
      "dgSoft": "rgba(217,31,73,0.12)",
      "dgGrad": "linear-gradient(180deg,#E83B60 0%,#D91F49 100%)",
      "ok": "#168B69",
      "warn": "#A86B12",
      "vip": "#7852A8",
      "vipGrad": "linear-gradient(135deg,#CDB1F2 0%,#7852A8 100%)",
      "onvip": "#FFFFFF",
      "shadow": {
        "sm": "0 1px 2px rgba(0,0,0,.22)",
        "md": "0 8px 28px rgba(0,0,0,.28)",
        "sheet": "0 -8px 32px rgba(0,0,0,.32)",
        "btn": "0 4px 16px rgba(37,244,238,0.15)",
        "btnDanger": "0 4px 14px rgba(254,44,85,0.16)"
      }
    }
  },
  "cssVarMap": {
    "cv": "--cv",
    "bg": "--bg",
    "sf": "--sf",
    "s2": "--s2",
    "s3": "--s3",
    "tx": "--tx",
    "t2": "--t2",
    "t3": "--t3",
    "ln": "--ln",
    "ln2": "--ln2",
    "ac": "--ac",
    "acHover": "--ac-hover",
    "acPressed": "--ac-pressed",
    "acSoft": "--ac-soft",
    "acGrad": "--ac-grad",
    "onac": "--onac",
    "dg": "--dg",
    "dgHover": "--dg-hover",
    "dgPressed": "--dg-pressed",
    "dgSoft": "--dg-soft",
    "dgGrad": "--dg-grad",
    "ok": "--ok",
    "warn": "--warn",
    "vip": "--vip",
    "vipGrad": "--vip-grad",
    "onvip": "--onvip"
  },
  "radius": {
    "xs": "8px",
    "sm": "12px",
    "md": "16px",
    "lg": "20px",
    "xl": "24px",
    "pill": "999px",
    "button": "14px",
    "iconButton": "12px",
    "input": "14px",
    "card": "16px",
    "bubble": "18px",
    "bubbleTail": "6px",
    "sheetTop": "20px",
    "avatar": "50%"
  },
  "motion": {
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "duration": "0.18s",
    "pressScalePrimary": 0.97,
    "pressScaleIcon": 0.9
  },
  "buttons": {
    "primary": {
      "class": ".pb",
      "default": {
        "fill": "var(--ac-grad)",
        "color": "var(--onac)",
        "shadow": "var(--sh-btn)",
        "radius": "14px",
        "height": 44,
        "weight": 700
      },
      "pressed": {
        "transform": "scale(0.97)"
      },
      "disabled": {
        "opacity": 0.4
      }
    },
    "secondary": {
      "class": ".pb.s",
      "default": {
        "fill": "var(--s2)",
        "color": "var(--tx)",
        "border": "1px solid var(--ln)"
      }
    },
    "ghost": {
      "class": ".lk, .pb.g",
      "default": {
        "fill": "transparent",
        "color": "var(--ac)"
      }
    },
    "danger": {
      "class": ".pb.d",
      "default": {
        "fill": "var(--dg-grad)",
        "color": "#FFFFFF"
      }
    },
    "icon": {
      "class": ".ib",
      "default": {
        "fill": "transparent",
        "color": "var(--t2)",
        "size": 44,
        "radius": "12px"
      }
    }
  },
  "swipeActions": {
    "pin": "#25F4EE",
    "mute": "#F6B94A",
    "hide": "#707078",
    "delete": "#FE2C55"
  }
}
