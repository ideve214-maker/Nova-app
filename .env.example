# NOVA 服务端环境变量示例（只有变量名和占位，不含真实密钥）。
# 适合：阿里云香港、Ubuntu 22.04、Node 22、nginx 在 80 端口反代到 127.0.0.1:8787。
# 复制为 /opt/nova/app/.env 或 systemd EnvironmentFile，按实际填写。不要把填好的密钥提交进仓库。

# —— 监听与数据库 ——
# 只让本机 nginx 访问时用 127.0.0.1；若要直接暴露再改 0.0.0.0。
HOST=127.0.0.1
PORT=8787
NOVA_DB=/opt/nova/data/nova.db

# —— 运行环境 ——
# 生产必须是 production。只有严格等于 development 才会打开 VIP 测试切换。
NOVA_ENV=production
# 开发环境才有意义；生产保持 0。
NOVA_VIP_TEST_TOGGLE=0

# —— 第一个管理员（仅当该用户名尚不存在时，启动时会创建；也可改用 npm run admin:create）——
# 密码 8–128 位且含字母和数字。两者必须同时提供，否则不会创建、也不会回落默认口令。
NOVA_ADMIN_USERNAME=admin
NOVA_ADMIN_PASSWORD=ChangeMe_toAStrongPass1

# —— CORS 白名单（精确匹配，含协议和端口）。生产不要用 *。必须包含管理端实际 Origin、iOS 与 Android 壳。 ——
NOVA_CORS_ORIGIN=https://admin.example.com,capacitor://localhost,http://localhost

# —— 反代与客户端 IP ——
# nginx 在本机回环上反代时打开；服务端才会读取 X-Forwarded-For / X-Forwarded-Proto。
# 未开启时忽略这些头，避免客户端伪造 IP。
NOVA_TRUST_PROXY=1
# 逗号分隔的受信对端地址；可写 127.0.0.1、::1。留空且 TRUST_PROXY=1 时信任直接对端（即 nginx）。
NOVA_TRUSTED_PROXIES=127.0.0.1,::1

# —— 浏览器 Cookie 会话（Capacitor 与 Agen 管理端继续用 Bearer，可保持关闭）——
# 设为 1 时，客户端可在登录时带 X-Nova-Session: cookie。
NOVA_COOKIE_SESSION=0
# 当前生产入口是 HTTP（80 端口）时必须为 0，否则浏览器不会保存 Secure Cookie。
# 配好 HTTPS 后再改为 1，并同步打开 HSTS。
NOVA_COOKIE_SECURE=0
# 仅在全站 HTTPS 后再设为 1。HTTP 下不要开，否则浏览器会拒绝后续明文访问。
NOVA_HSTS=0

# —— 限流与告警 ——
# 空或 lenient：较宽；strict：生产建议；0 或 off：关闭。
NOVA_RATE_LIMIT=strict
# 崩溃、磁盘不足、数据库错误、SSE 失败时 POST JSON。不设则只写日志。
NOVA_ALERT_WEBHOOK=

# —— 备份（scripts/backup.sh 读取）——
NOVA_BACKUP_DIR=/opt/nova/backups
NOVA_BACKUP_KEEP=14
# systemd 单元名，供 backup.sh restore 停/启服务。
NOVA_SERVICE=nova

# —— 媒体工具（可选，默认用 PATH 里的 ffmpeg / ffprobe）——
NOVA_FFMPEG=ffmpeg
NOVA_FFPROBE=ffprobe

# —— 若本进程同时托管前端 HTML，CSP connect-src 可填 API 公网源（多数情况由 nginx 同源反代，可留空）——
NOVA_API_BASE=

# —— 支付（人工收款码；不要填写真实商户密钥）——
# manual_qr（默认）| mock（仅测试，需 MOCK_SECRET）| 其他官方渠道目前是未配置桩。
NOVA_PAY_PROVIDER=manual_qr
NOVA_PAY_WECHAT_ENABLED=1
NOVA_PAY_ALIPAY_ENABLED=1
# 覆盖默认遮罩收款码：本地路径或 https URL。不要把未遮罩原图放进仓库。
NOVA_PAY_WECHAT_QR=
NOVA_PAY_ALIPAY_QR=
NOVA_PAY_WECHAT_NOTE=
NOVA_PAY_ALIPAY_NOTE=
# 订单过期（分钟，默认 1440）与每用户待处理上限（默认 3）。
NOVA_PAY_ORDER_EXPIRE_MINUTES=1440
NOVA_PAY_PENDING_LIMIT=3
# 仅 mock 渠道需要。生产不要配置。
NOVA_PAY_MOCK_SECRET=
